# Placeholders only. Copy to .env.local and fill in real values locally.
# NEVER commit real keys. .env.local is git-ignored.
# Nothing here is used yet: Supabase arrives in Phase 3/4, email in Phase 5.

# Supabase (Phase 3+)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Server-only. Must never be prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email provider (Phase 5)
EMAIL_API_KEY=your-email-provider-api-key
EMAIL_FROM_ADDRESS=reminders@example.com

# Cron protection (Phase 5)
CRON_SECRET=generate-a-long-random-string

# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
